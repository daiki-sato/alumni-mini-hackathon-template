# 本番（Vercel）用のテンプレート。
# 値は Supabase のダッシュボード → Project Settings → API から取得します。
# Vercel の Environment Variables に同じ名前で設定してください。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps（ブラウザ用のキー1本。HTTP リファラと API の制限をかける。README「Google Maps のキーを設定する」）
# 空のままならデモデータで動きます。
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# 任意。未設定なら DEMO_MAP_ID
NEXT_PUBLIC_GOOGLE_MAP_ID=
